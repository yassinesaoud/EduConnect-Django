## Production / Vercel only: use the pooled Neon connection string
## (the hostname contains "-pooler"). Keep this empty for local SQLite.
DATABASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PEDAGOGIE_GEMINI_MODEL=gemini-3.1-flash-lite

## Stockage des documents de cours (obligatoire sur Vercel)
## Sur Vercel le systeme de fichiers est en lecture seule : sans un stockage
## objet configure, l'envoi d'un document renvoie une erreur.
## Creer un Blob Store dans le dashboard Vercel (Store -> Create Blob Store) :
##   - BLOB_STORE_ID suffit sur Vercel (authentification OIDC de la plateforme) ;
##   - sinon un jeton de lecture/ecriture BLOB_READ_WRITE_TOKEN
##     (format vercel_blob_rw_<store_id>_<secret>) pour un usage hors Vercel.
## https://vercel.com/docs/vercel-blob
BLOB_STORE_ID=
## BLOB_READ_WRITE_TOKEN=
## Mode d'acces du store : public (par defaut) ou private
## BLOB_ACCESS=public

## Alternative : stockage compatible S3 (Cloudflare R2, MinIO, Backblaze...)
## AWS_STORAGE_BUCKET_NAME=
## AWS_ACCESS_KEY_ID=
## AWS_SECRET_ACCESS_KEY=
## AWS_S3_ENDPOINT_URL=
## AWS_S3_REGION_NAME=auto
